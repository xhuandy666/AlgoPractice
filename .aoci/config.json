{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    "vendor",
    "dist",
    "build",
    "target",
    ".next",
    "coverage",
    "tmp",
    "uploads",
    "backup",
    "backups",
    "artifacts",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 8000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "screenshot-acm-workbench",
        "action": "observe",
        "pattern": ".github/assets/screenshots/acm-workbench.png",
        "pattern_kind": "file",
        "reason": "用户明确批准此PNG沿用截图仅观察策略，保留变化复核而不创作文本条目，不扩大其他文件边界",
        "decision_basis": "maintainer_direction",
        "source": "user",
        "created_by": "codex",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "screenshot-hot100",
        "action": "observe",
        "pattern": ".github/assets/screenshots/hot100.png",
        "pattern_kind": "file",
        "reason": "用户明确批准此PNG沿用截图仅观察策略，保留变化复核而不创作文本条目，不扩大其他文件边界",
