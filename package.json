{
  "name": "algopractice",
  "productName": "题炼",
  "version": "0.7.0",
  "private": true,
  "description": "题炼：算法练习、力扣官方提交、AI 教练与间隔复习",
  "author": "xhuandy666",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/prepare-windows-helper.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev:web": "vite --host 127.0.0.1",
    "runtime:install": "node --import tsx scripts/runtime-install.ts",
    "pretest": "node scripts/prepare-tests.mjs",
    "test": "tsx --test tests/runner/*.test.ts tests/storage/*.test.ts tests/source/*.test.ts tests/desktop/*.test.ts tests/learning/*.test.ts tests/ai/*.test.ts tests/interview/*.test.ts",
    "test:desktop": "node tests/public-desktop-smoke.mjs",
    "test:ai": "node tests/p5-ai-protocol-smoke.mjs",
    "test:official": "node tests/official-judge-smoke.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "preruntime:install": "node scripts/prepare-windows-helper.mjs",
    "test:learning-center": "node tests/learning-center-smoke.mjs",
    "test:editor-performance": "node tests/editor-performance-smoke.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dompurify": "3.4.15",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "marked": "18.0.12",
    "monaco-editor": "0.56.0",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "local.algopractice.desktop",
    "artifactName": "AlgoPractice-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": ".runtime-tools/windows-job-helper.exe",
          "to": "windows-job-helper.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  },
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xhuandy666/AlgoPractice.git"
  },
  "homepage": "https://github.com/xhuandy666/AlgoPractice",
  "bugs": {
    "url": "https://github.com/xhuandy666/AlgoPractice/issues"
  }
}
